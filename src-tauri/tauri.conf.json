{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kensaku",
  "version": "1.0.17",
  "identifier": "com.gochi.kensaku",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$CONFIG/kensaku/thumbs/**",
          "$APPCONFIG/thumbs/**",
          "$APPLOCALDATA/kensaku/thumbs/**",
          "$APPDATA/kensaku/thumbs/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "publisher": "Yash Jangid",
    "copyright": "Copyright \u00a9 2026 Yash Jangid",
    "category": "Productivity",
    "shortDescription": "Fast local search for files, content, documents and images.",
    "longDescription": "Kensaku indexes filenames, file contents, PDFs, Office documents and OCR'd images into one local index. It is a desktop app and a read-only search backend for AI agents (MCP + CLI). No cloud, no telemetry.",
    "homepage": "https://github.com/yjid/kensaku",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./nsis/hooks.nsh",
        "installerIcon": "./icons/icon.ico",
        "uninstallerIcon": "./icons/icon.ico"
      }
    },
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
